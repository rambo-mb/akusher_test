# --- Backend (apps/api) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/akutest?schema=public"
# BotFather'dan olingan token
BOT_TOKEN="123456:ABC-DEF..."
# JWT imzolash uchun maxfiy kalit (tasodifiy uzun satr)
JWT_SECRET="change-me-to-a-long-random-string"
# Mini App (frontend) URL — bot tugmasi shu manzilni ochadi
WEB_APP_URL="https://your-app.example.com"
# Server porti
PORT=3000
# Prod'da bot webhook uchun public API URL (masalan https://api.example.com). Bo'sh bo'lsa long-polling.
PUBLIC_API_URL=""
# Admin (bot egasi) Telegram raqamli ID'si. Botда /myid yozib bilib olasiz.
# Faqat shu foydalanuvchi foydalanuvchilarni tasdiqlay oladi va o'zi avto-tasdiqlanadi.
ADMIN_TELEGRAM_ID=""

# --- Frontend (apps/web) ---
# API manzili (build vaqtida ishlatiladi)
VITE_API_URL="http://localhost:3000"
