{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "corepack enable && pnpm install --frozen-lockfile && pnpm --filter @aku/api build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @aku/api start:prod",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE"
  }
}
